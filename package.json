{
  "name": "@penny/web", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "build:shared": "tsc -p ../api/shared/tsconfig.json",
    "dev": "npm run build:shared && next dev --webpack --hostname localhost --port 5173",
